# --- Telegram ---------------------------------------------------------------
# token from @BotFather
BOT_TOKEN=
# only change for a self-hosted Bot API server
TELEGRAM_API_BASE=https://api.telegram.org
# your own numeric Telegram id(s), comma separated (send /id to the bot to learn it)
ADMIN_IDS=

# --- AmneziaWG server -------------------------------------------------------
# "awg" = real server, "mock" = dry run, nothing is touched
BACKEND=awg
AWG_IFACE=awg0
AWG_CONF=/etc/amnezia/amneziawg/awg0.conf
AWG_BIN=awg
# Amnezia's Docker install (very common): set the container name and the path INSIDE it.
# Everything then goes through `docker exec`, the host needs no awg binary.
#   AWG_DOCKER=amnezia-awg2      (or amnezia-awg)
#   AWG_CONF=/opt/amnezia/awg/awg0.conf
AWG_DOCKER=

# public address clients connect to: IP or domain, and the ListenPort from the server config
ENDPOINT_HOST=vpn.example.com
ENDPOINT_PORT=51820

# optional: left empty, the key is derived from PrivateKey in the server config
SERVER_PUBLIC_KEY=

# --- client config ----------------------------------------------------------
SUBNET=10.8.0.0/24
SERVER_IP=10.8.0.1
# addresses the bot must never hand out (e.g. a fixed peer you keep for yourself).
# peers that already exist in the server config are detected and skipped automatically.
RESERVED_IPS=
DNS=1.1.1.1
ALLOWED_IPS=0.0.0.0/0, ::/0
PERSISTENT_KEEPALIVE=25
# leave empty to use the MTU of the server config
MTU=

# --- policy -----------------------------------------------------------------
MAX_PEERS_PER_USER=1
REQUEST_COOLDOWN_S=60
# true: every new key waits for an admin press. false: keys are issued instantly.
REQUIRE_APPROVAL=true
# what the user receives: both by default
SEND_VPN_LINK=true
SEND_CONF_FILE=true

# --- storage ----------------------------------------------------------------
DB_PATH=awgbot.db
MOCK_STATE=mock_awg_state.json
LOG_LEVEL=INFO
